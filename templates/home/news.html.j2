<!DOCTYPE html>
<html>
    <head>
        <link rel="icon" type="image/svg+xml" href="{{ url_for('static', filename='assets/logo.svg') }}">
        <title>NicheGames - News</title>
        <meta charset="utf-8">
        <link rel="stylesheet" type="text/css" href="{{ url_for('static', filename='home/news/news.css') }}">
        <link rel="stylesheet" type="text/css" href="{{ url_for('static', filename='home/home.css') }}">
